# Copy to .env and replace every "change-me". Never commit .env.

APP_ENV=dev

# --- Postgres container (used by docker compose + db/bootstrap) ---
POSTGRES_PORT=5432
# Superuser password; only used by the bootstrap script.
POSTGRES_PASSWORD=change-me
# Owns the schema; runs migrations and seed. Never used by the API.
APP_MIGRATOR_PASSWORD=change-me
# API runtime role (NOSUPERUSER NOBYPASSRLS).
APP_USER_PASSWORD=change-me

# --- Connection strings used by the app / scripts ---
APP_DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/ztrag
MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-me@127.0.0.1:5432/ztrag

# --- Test database (separate DB so tests never touch dev data) ---
TEST_APP_DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/ztrag_test
TEST_MIGRATOR_DATABASE_URL=postgresql://app_migrator:change-me@127.0.0.1:5432/ztrag_test
